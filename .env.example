# ==============================================================================
# Kyro Environment Configuration Example
# ==============================================================================
# Copy this file to .env or configure these variables in your system environment.
# Note: Sensitive credentials and API keys configured through the Kyro UI Settings
# are securely stored in your Operating System Keyring (Vault) and never written to disk in plaintext.
# ==============================================================================

# Model Provider Endpoints & Keys (Optional override; UI Settings takes precedence)
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remote Notification Bridge (Optional)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789

# Developer & Logging Controls
RUST_LOG=info
RUST_BACKTRACE=1
DEV_PORT=1420

# Display & Headless Mode (Linux only)
# DISPLAY=:0
# WAYLAND_DISPLAY=wayland-0
